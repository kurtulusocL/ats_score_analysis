{
    "ConnectionStrings": {
        "DefaultConnection": "YOUR_CONNECTIN_STRING"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        }
    },
    "RapidApi": {
        "Key": "YOUR_RAPIDAPI_KEY",
        "Host": "google-api31.p.rapidapi.com"
    },
    "AppSettings": {
        "ReportOutputPath": "Reports",
        "SupportedFileTypes": [ "pdf", "docx", "txt" ],
        "MaxFileSizeMb": 10
    }
}